# Production settings. Copy to deploy/.env on the server and fill in. Never commit the real file.

# The address customers type, pointed at this server by a DNS A record.
DOMAIN=order.example.com
# Let's Encrypt writes here about the HTTPS certificate.
ACME_EMAIL=you@example.com

# Database passwords. Letters and digits only (they go into a URL). Make each with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# "none" runs the shop counter-only: no online ordering. Keep it until a merchant account exists.
PAYMENT_GATEWAY=none
# Needed once a real gateway is set: a random secret of 32+ characters (openssl rand -hex 32).
GATEWAY_WEBHOOK_SECRET=

# Nightly backup, in shop time.
SHOP_TIMEZONE=Asia/Kuala_Lumpur
BACKUP_TIME=04:30
BACKUP_KEEP_DAYS=14
# Strongly recommended: also copy each backup off this server. See the README.
RCLONE_REMOTE=
