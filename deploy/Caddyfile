{
	# Certificate expiry and renewal notices from Let's Encrypt go here.
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		-Server
	}

	# The API and uploaded photos. Caddy sets X-Forwarded-For to the real client address,
	# which the API trusts because BEHIND_PROXY=true.
	@api path /api/* /media/*
	handle @api {
		request_body {
			max_size 10MB
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Built files have a content hash in their name and never change.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Everything else (index.html, the service worker, the manifest) is checked on every load,
		# so a new release reaches the tablet on its next refresh.
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
